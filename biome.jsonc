// Biome's config carries its reasons as comments, which only the .jsonc name allows: with a comment inside
// biome.json, biome processes zero files.
{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!tests/fixtures",
      "!**/dist",
      "!**/*.css",
      "!src/apps/web/**/*.astro",
      "!.github/repo-platform-manifest.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "quoteProperties": "preserve",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "plugins": [
    {
      "path": "./src/apps/extension/lint/module-scope-let.grit",
      "includes": ["**/extension/src/lib/**"]
    }
  ],
  "linter": {
    "enabled": true,
    "domains": {
      "project": "all"
    },
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnresolvedImports": "off",
        "useImportExtensions": "off"
      },
      "nursery": {
        "noFloatingPromises": "error"
      },
      "performance": {
        "noBarrelFile": "error",
        "noReExportAll": "error"
      },
      "style": {
        "noParameterAssign": "off",
        "noNonNullAssertion": "off",
        "useNodejsImportProtocol": "error",
        "useImportType": "error",
        "useNamingConvention": {
          "level": "warn",
          "options": {
            "strictCase": false,
            "conventions": [
              // A custom convention checks the whole name, so biome's default trimming of leading and trailing
              // underscores and dollars is lost; this forwards the trimmed name (wire tags like __evalError and
              // _meta, JSON Schema's $ref) to the conventions below.
              {
                "match": "[_$]*(.*?)[_$]*"
              },
              // Chrome's _locales directory names (zh_CN) are a key shape no case format covers.
              {
                "selector": {
                  "kind": "objectLiteralProperty"
                },
                "match": "[a-z]{2}_[A-Z]{2}|(.*)"
              },
              {
                "selector": {
                  "kind": "function"
                },
                "formats": ["camelCase", "PascalCase"]
              },
              {
                "selector": {
                  "kind": "objectLiteralMethod"
                },
                "formats": ["camelCase"]
              },
              {
                "selector": {
                  "kind": "classMethod"
                },
                "formats": ["camelCase"]
              },
              {
                "selector": {
                  "kind": "classProperty"
                },
                "formats": ["camelCase"]
              },
              {
                "selector": {
                  "kind": "variable"
                },
                "formats": ["camelCase", "CONSTANT_CASE", "PascalCase"]
              },
              {
                "selector": {
                  "kind": "functionParameter"
                },
                "formats": ["camelCase"]
              },
              {
                "selector": {
                  "kind": "class"
                },
                "formats": ["PascalCase"]
              },
              {
                "selector": {
                  "kind": "interface"
                },
                "formats": ["PascalCase"]
              },
              {
                "selector": {
                  "kind": "typeAlias"
                },
                "formats": ["PascalCase"]
              },
              {
                "selector": {
                  "kind": "objectLiteralProperty"
                },
                "formats": ["camelCase", "snake_case", "CONSTANT_CASE", "PascalCase"]
              },
              // Type properties describe the same JSON shapes object literals do (manifest keys, serde fields).
              {
                "selector": {
                  "kind": "typeProperty"
                },
                "formats": ["camelCase", "snake_case", "CONSTANT_CASE", "PascalCase"]
              }
            ]
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noImplicitAnyLet": "off",
        "noConsole": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "tests/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnresolvedImports": "off"
          },
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ]
}
