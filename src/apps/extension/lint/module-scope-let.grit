language js(typescript)

// A bare module-scope `let` under lib/ is one life's state nothing enumerates or resets; it goes in an
// inLife cell (src/lib/shared/in-life.ts). Nesting is matched by exclusion, so an unlisted construct over-flags
// rather than misses. tests/lint/module-scope-let.test.ts runs this file against a fixture of every shape.
or {
  JsVariableStatement(),
  JsVariableDeclarationClause()
} as $stmt where {
  $stmt <: r"^let\s[\s\S]*",
  not $stmt <: within or {
    JsFunctionBody(),
    JsBlockStatement(),
    JsCaseClause(),
    JsDefaultClause(),
    JsStaticInitializationBlockClassMember(),
    TsModuleBlock()
  } ,
  register_diagnostic(span=$stmt, message="module-scope `let` is one life's state: declare it `const x = inLife(() => initial)` (src/lib/shared/in-life.ts) so it is enumerable and resets with the life")
}
