# libFuzzer dictionary for the JSON-speaking targets: nm_frame, mcp_jsonrpc,
# bridge_envelope, handshake, attach, classify_frame, registration_manifest.
# JSON structure tokens plus the protocol's tag/key/value strings, so mutation
# reaches past the JSON parser into the typed decodes.

# JSON structure
"{"
"}"
"["
"]"
":"
","
"\""
"true"
"false"
"null"

# Envelope and handshake keys
"\"type\""
"\"nonce\""
"\"context\""
"\"mac\""
"\"label\""
"\"challenge\""
"\"response\""
"\"attach\""
"\"browser\""
"\"client\""
"\"harness\""
"\"hash\""
"\"team_id\""
"\"id\""
"\"op\""
"\"args\""
"\"tabId\""
"\"ok\""
"\"data\""
"\"error\""

# MCP JSON-RPC
"\"jsonrpc\""
"\"2.0\""
"\"method\""
"\"params\""
"\"result\""
"\"code\""
"\"message\""

# MCP 2026-07-28 era negotiation (server/discover, _meta version marker)
"\"io.modelcontextprotocol/protocolVersion\""
"\"io.modelcontextprotocol/clientCapabilities\""
"\"io.modelcontextprotocol/serverInfo\""
"\"server/discover\""
"\"tools/list\""
"\"tools/call\""
"\"2026-07-28\""
"\"_meta\""
"\"resultType\""
"\"supportedVersions\""
"\"ttlMs\""
"\"cacheScope\""
"\"initialize\""

# Host-control frame tags (EnclaveControl / AdminControl)
"\"enclave_challenge\""
"\"enclave_proof\""
"\"enclave_error\""
"\"enclave_revoke\""
"\"enclave_revoked\""
"\"presence_challenge\""
"\"presence_proof\""
"\"presence_error\""
"\"client_list\""
"\"client_list_result\""
"\"client_revoke\""
"\"client_revoke_result\""
"\"kill_status\""
"\"kill_engage\""
"\"kill_release\""
"\"kill_status_result\""
"\"audit_event\""
"\"kind\""
"\"outcome\""
"\"tool\""
"\"detail\""
"\"cid\""
"\"sig\""
"\"key_id\""
"\"pubkey\""
"\"reason\""

# Policy and language control frame tags and keys (PolicyControl, ADR-0032)
"\"policy_get\""
"\"policy_current\""
"\"legacy_settings\""
"\"lang_get\""
"\"lang_set\""
"\"lang_current\""
"\"baseline\""
"\"overlay\""
"\"bag\""
"\"value\""
"\"seq\""

