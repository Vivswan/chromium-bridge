# store and history envelope keys as they appear in JSON)
"\"v\""
"\"revision\""
"\"touched\""
"\"cdpMode\""
"\"fileUploadEnabled\""
"\"handleDialogEnabled\""
"\"pageEvalEnabled\""
"\"confirmHighRiskClick\""
"\"confirmPageEval\""
"\"touchIdConfirm\""
"\"confirmTabClose\""
"\"warnPreciseSnapshot\""
"\"evalMask\""
"\"hostReverifyMs\""
"\"confirmGraceMs\""
"\"clickToastTimeoutMs\""
"\"evalToastTimeoutMs\""
"\"disabledTools\""
"\"version\""
"\"baseline_b64\""
"\"sig_b64\""
"\"entries\""
"\"superseded_unix\""

