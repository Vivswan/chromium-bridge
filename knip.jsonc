{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  // Binaries that moon tasks and CI provide outside package.json: the task
  // runner itself, the Rust toolchain, uv (the proto-managed Python runner the
  // presence suite spawns to mint its host key), and the Windows registry tool
  // the browser e2e drives on that platform.
  "ignoreBinaries": ["moon", "rustup", "rustc", "uv", "reg.exe"],
  "workspaces": {
    ".": {
      // fake-llm.ts is launched by name from a moon task as well as imported by run.ts; the
      // driver test is launched by the check-harness-driver task and a checks.yml step.
      "entry": ["tests/harness/fake-llm.ts", "tests/harness/*.test.ts"],
      "project": ["tests/harness/**/*.ts"]
    },
    // Launch points knip cannot see for itself: moon task commands (it reads
    // package scripts and workflow steps, not moon.yml; every check-*.ts is a
    // moon check task) and the scripts other scripts spawn by path (dev.ts
    // starts dev-browser.ts). Helpers such as lib.ts are reached through
    // imports and stay project files.
    "scripts": {
      "entry": [
        "tests/*.test.ts",
        "arch-lint.ts",
        "check-*.ts",
        "compose-run.ts",
        "dev-browser.ts",
        "dev.ts",
        "docs-probe.ts",
        "gen-envelope.ts",
        "gen-ops.ts",
        "help.ts",
        "render-architecture-map.ts"
      ],
      "project": ["**/*.ts"]
    },
    // WXT entrypoints: the service worker, the content script, and each
    // page's main.tsx (the page's index.html loads it).
    "src/apps/extension": {
      "entry": ["src/entrypoints/*.ts", "src/entrypoints/*/main.tsx"],
      "project": ["src/**/*.{ts,tsx,css}", "tests/**/*.{ts,tsx}"],
      // #i18n is the module @wxt-dev/i18n generates into .wxt/ at `wxt prepare`, a build output the fleet's
      // knip run (a bare install) does not have; the typecheck resolves it.
      "ignoreUnresolved": ["#i18n"]
    },
    "src/packages/shared": {
      "project": ["src/**/*.ts", "tests/**/*.ts"],
      // deep-freeze-es6 is imported only by generated/policy.ts, the build output `moon run gen` writes, which
      // the fleet's knip run (a bare install) does not have.
      "ignoreDependencies": ["deep-freeze-es6"]
    },
    // The e2e and the runner that chains the suites are launched by name from
    // moon tasks; the other suites are package scripts knip reads itself.
    "tests/browser": {
      // fake_host.ts is spawned by Chrome through the profile's exec wrapper, never imported.
      "entry": ["*.test.ts", "integration_e2e.ts", "run_all.ts", "fake_host.ts"],
      "project": ["**/*.ts"]
    },
    "tests/interop": {
      "project": ["**/*.ts"]
    },
    "src/apps/web": {
      "project": ["src/**/*.{ts,mjs,astro}"]
    }
  }
}
