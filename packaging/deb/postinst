#!/bin/sh
# dpkg runs this as root, so the registration is the machine-wide one every account's browser reads; the
# binary refuses the per-user scope as root and the system scope without root. No browser on the machine
# yet is a valid install (exit 3: nothing to register, the binary prints the hint), unlike a registration
# that failed, which leaves the package unconfigured so the failure is seen.
set -e
/usr/bin/genkan doctor --fix --system || test $? -eq 3
