#!/bin/bash
# Installer hands this to installd, which runs it as root in its own environment: USER is root and the
# caller's SUDO_USER is gone, so the account to register is read from the console session itself. Nobody
# logged in means the owner is root, and the test line fails the install there rather than register root.
set -eu
user="$(stat -f %Su /dev/console)"
test "$user" != root
exec sudo -u "$user" -H /usr/local/bin/chromium-bridge doctor --fix
