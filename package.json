{
  "name": "chromium-bridge",
  "private": true,
  "description": "Authenticated MCP bridge to your real Chromium browsers - bun workspace root.",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "src/apps/extension",
    "src/apps/desktop/ui",
    "src/packages/*",
    "tests/browser",
    "tests/interop",
    "scripts",
    "src/apps/web"
  ],
  "scripts": {
    "gen": "moon run gen",
    "typecheck": "moon run typecheck",
    "build": "moon run build",
    "lint": "moon run lint-ts",
    "format": "moon run fmt-ts",
    "format:check": "moon run fmt-check-ts",
    "check": "moon run check-ts",
    "test": "moon run test-ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@tauri-apps/cli": "^2.11.4",
    "@types/bun": "1.4.0",
    "lefthook": "2.1.12",
    "typescript": "7.0.2"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "brace-expansion": "^5.0.9",
    "js-yaml": "^4.3.1",
    "multimatch": "^8.0.0",
    "nanoid": "^3.3.17",
    "sharp": "^0.35.3",
    "shell-quote": "^1.8.4",
    "tmp": "^0.2.6"
  }
}
