# cargo-fuzz fuzzer-generated corpus and crash reproducers. The fuzz crate
# (src/packages/core/fuzz/Cargo.toml + fuzz_targets/) and its lockfile ARE
# tracked; only the machine-generated outputs are ignored (build artifacts
# land in target/, covered by the managed Rust section below).
/src/packages/core/fuzz/corpus/
/src/packages/core/fuzz/artifacts/
/src/packages/core/fuzz/coverage/
# fuzz-smoke.ts failure reports (cleared and rewritten per run, consumed by
# the nightly job's issue filing)
/src/packages/core/fuzz/failures/

# Icon rasters rendered from the committed assets/icon/ SVGs by
# scripts/gen-icons.ts (run by the extension and desktop builds) - build
# artifacts, never committed
/src/apps/extension/src/public/icons/
/src/apps/desktop/icons/

# Unified build-output folder: all build deliverables (extension bundle,
# desktop UI, signed app copy, dmg staging + image) land here
/build/

# Extension build staging (WXT codegen; the bundle itself goes to /build/)
src/apps/extension/.wxt/

# Astro's generated types (the web app builds into /build/web/)
/src/apps/web/.astro/

# Downloaded isolated Chrome for Testing (browser suites; never committed)
/tests/.chrome-for-testing/

# Tauri desktop shell (src/apps/desktop): gen/ holds the capability schemas
# tauri-build writes on every compile.
/src/apps/desktop/gen/

# Local install destination (binaries live in ~/.chromium-bridge/, but guard
# against accidental copies into the repo)
/chromium-bridge
/chromium-bridge.exe
*.dSYM/

# Test scratch
/tmp/

# Agent working notes (audits, handoffs, consolidation scratch) - local only
/.notes/

# Python bytecode cache from the tests/protocol/ harness (adversarial.py imports e2e.py)
tests/protocol/__pycache__/

# Isolated browsers downloaded for the browser suites
# (npx @puppeteer/browsers install ... run from tests/)
/tests/chrome/
/tests/chromium/

# moon's local task cache and state (.moon/*.yml configs ARE tracked)
/.moon/cache/

# Development worktrees (see CONTRIBUTING.md - one per branch, never committed)
/.worktrees/

# Chrome Web Store upload package (built from dist/, never committed)
/chromium-bridge-extension-cws-*.zip

# Playwright MCP scratch
/.playwright-mcp/

# Extension signing keys - never commit
*.pem

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

