# proto is the bootstrap toolchain manager: `proto install` in a fresh checkout provisions every pin
# below, and CI provisions from this same file (.github/actions/setup-moon in every job; the Containerfile
# at image build). rust is deliberately absent: rust-toolchain.toml is its only pin, read by rustup, IDEs,
# and CI's setup-rust-toolchain, and proto's rust plugin would register a toolchain without a rustc that
# makes rustup believe the pin is installed.
#
# One pin is necessarily duplicated, and scripts/check-toolchain.ts (`moon run check-toolchain`, in the ci
# gate) fails if the copies disagree:
#   bun   package.json's packageManager field and the template-managed .bun-version.
# uv keeps owning python: the protocol suites run under the interpreter pinned in .python-version via
# `uv run --no-project --isolated`, so proto never provisions python (the allow-list below excludes it).
#
# Named residual gap: four gate tools have no first-party proto plugin and are NOT provisioned here:
# cargo-nextest, typos, cargo-machete, actionlint. Install them once by hand (docs/development.md); the CI
# image carries pinned copies, and the managed ci.yml runs typos and actionlint through fleet actions.
proto = "0.58.2"
bun = "1.4.2"
moon = "2.4.5"
node = "24.21.0"
uv = "0.11.26"

[settings]
# Only the tools we pin. Without this allow-list, `proto install` would also detect .python-version and
# rust-toolchain.toml and install its own python and rust: two provisioners for one interpreter is exactly
# the drift this file exists to prevent, and proto's rust install breaks rustup's (see the header).
builtin-plugins = ["bun", "moon", "node", "uv"]
